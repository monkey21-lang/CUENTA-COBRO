{
  "name": "cuenta_cobro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3002",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start --hostname 0.0.0.0 --port 3002",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate:local": "prisma db push",
    "db:migrate:cloudflare:local": "wrangler d1 migrations apply cuenta-clara --local",
    "db:migrate:cloudflare:remote": "wrangler d1 migrations apply cuenta-clara --remote",
    "db:seed:users": "node scripts/seed-users.mjs local",
    "db:seed:users:d1-local": "node scripts/seed-users.mjs d1-local",
    "db:seed:users:remote": "node scripts/seed-users.mjs remote",
    "db:cloudflare:local": "wrangler d1 migrations apply cuenta-clara --local",
    "db:cloudflare:remote": "wrangler d1 migrations apply cuenta-clara --remote",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.141.0"
  }
}
