generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Invoice {
  id             String        @id @default(cuid())
  headerTitle    String
  brandName      String
  issuerTaxId     String        @default("")
  issuerAddress  String        @default("")
  logoDataUrl    String?
  invoiceNumber  String
  invoiceDate    DateTime
  customerName   String
  customerNumber String
  customerAddress String
  customerCity   String        @default("")
  customerPhone  String        @default("")
  servicePeriod  String        @default("")
  paymentTerms   String        @default("")
  observations   String        @default("")
  contactEmail   String
  contactPhone   String
  contactWebsite String
  bankName       String
  accountName    String
  accountNumber  String
  discountPercent Float
  subtotalCents  Int
  discountCents  Int
  totalCents     Int
  items          InvoiceItem[]
  createdAt      DateTime      @default(now())

  @@index([invoiceDate])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  description    String
  unitPriceCents Int
  quantity       Int
  position       Int
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}